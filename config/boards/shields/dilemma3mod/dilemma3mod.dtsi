/*
 * Dilemma-3mod (https://github.com/dixls/Dilemma-3mod): 3x5 + 3 thumbs per
 * half, reversible PCB, nice!nano v2 compatible controller.
 *
 * Pins read from the KiCad PCB (same as QMK bastardkb/dilemma promicro), in
 * Pro Micro numbering:
 *   rows: D4 (4) top, C6 (5) home, F5 (20) bottom, F7 (18) thumbs
 *   cols: B4 (8), B5 (9), E6 (7), D7 (6), F6 (19), outer to inner
 * Diodes are ROW2COL. The right half lists the columns reversed.
 * Thumbs sit on columns 1, 3 and 4 (outer, middle, inner) of the thumb row.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                RC(3,0) RC(3,2) RC(3,3)   RC(3,6) RC(3,7) RC(3,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        wakeup-source;

        row-gpios
            = <&pro_micro 4 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>
            ;
    };
};
